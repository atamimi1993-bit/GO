{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "biweekly_driver_ad_generation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "generate_driver_ads": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generate-ads",
            "args": {
              "audience": "drivers"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Generate driver ads",
            "description": "Create new driver incentive ads and codes every 2 weeks"
          }
        }
      }
    ]
  },
  "name": "Biweekly Driver Ad Generation",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 14,
      "interval_unit": "days",
      "interval_anchor": "2026-07-04T09:00:00Z",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Auto-generates promotional ads and promo codes for drivers every 2 weeks. Deactivates old driver campaigns and creates fresh earning incentive content."
}
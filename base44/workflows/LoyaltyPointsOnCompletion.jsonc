{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "loyalty_points_on_completion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "award_points": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "award-loyalty-points",
            "args": {
              "move_request_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Award loyalty points",
            "description": "Give customer 1 point per $1 spent on the completed move"
          }
        }
      }
    ]
  },
  "name": "Loyalty Points on Move Completion",
  "trigger": {
    "condition": "${ .trigger.event_type == \"update\" and .trigger.data.status == \"completed\" and .trigger.old_data.status != \"completed\" }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "MoveRequest"
    }
  },
  "description": "When a MoveRequest status changes to completed, award loyalty points to the customer (1 point per $1 spent)."
}
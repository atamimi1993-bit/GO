{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "upcoming_move_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scan_and_remind": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notify-upcoming-move",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Scan moves and send reminders",
            "description": "Send 24h and 1h reminders to customers and drivers"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 30,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every 30 minutes, scans accepted and in-progress moves and sends 24-hour and 1-hour reminders to both customers and assigned drivers about upcoming move times. Uses idempotency flags on MoveRequest to avoid duplicate reminders.",
  "name": "Upcoming Move Reminders"
}
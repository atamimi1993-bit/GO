{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "installment_payment_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "send-installment-reminder"
          },
          "then": "end",
          "x-base44": {
            "title": "Send installment reminders",
            "description": "Email customers with outstanding balances"
          }
        }
      }
    ]
  },
  "name": "Installment Payment Reminder",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Daily reminder emails to customers with active 3-installment payment plans who still have a remaining balance."
}
{
  "name": "Referral Bonus on Move Completion",
  "description": "When a MoveRequest with a referral_code is marked complete, award 500 bonus loyalty points to the referrer and notify them by email.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "MoveRequest",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.event_type == \"update\" and .trigger.data.status == \"completed\" and .trigger.old_data.status != \"completed\" and .trigger.data.referral_code != null and .trigger.data.referral_code != \"\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "referral_bonus_on_completion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "award_referral": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "award-referral-points",
            "args": {
              "move_request_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Award referral bonus points",
            "description": "Give the referrer 500 bonus loyalty points when their friend's move completes"
          }
        }
      }
    ]
  }
}
{
  "name": "AppNotification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning",
        "alert",
        "job"
      ],
      "default": "info"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "link": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "title",
    "body"
  ],
  "rls": {
    "create": true,
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}
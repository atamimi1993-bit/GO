{
  "name": "LoyaltyAccount",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "total_points": {
      "type": "number",
      "default": 0
    },
    "moves_completed": {
      "type": "number",
      "default": 0
    },
    "last_awarded_move_id": {
      "type": "string"
    },
    "referral_code": {
      "type": "string"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
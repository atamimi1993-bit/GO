{
  "name": "Truck",
  "type": "object",
  "properties": {
    "driver_profile_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "make": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "size_category": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large",
        "extra_large"
      ]
    },
    "capacity_lbs": {
      "type": "number"
    },
    "license_plate": {
      "type": "string"
    },
    "registration_doc_url": {
      "type": "string"
    },
    "inspection_doc_url": {
      "type": "string"
    },
    "insurance_doc_url": {
      "type": "string"
    },
    "fuel_type": {
      "type": "string",
      "enum": [
        "gasoline",
        "diesel",
        "electric",
        "hybrid"
      ],
      "default": "gasoline"
    },
    "mpg": {
      "type": "number",
      "default": 10
    },
    "photo_url": {
      "type": "string"
    },
    "exterior_photo_url": {
      "type": "string"
    },
    "interior_photo_url": {
      "type": "string"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "company_name": {
      "type": "string"
    },
    "current_mileage": {
      "type": "number",
      "default": 0
    },
    "last_maintenance_date": {
      "type": "string",
      "format": "date"
    },
    "next_maintenance_date": {
      "type": "string",
      "format": "date"
    },
    "maintenance_notes": {
      "type": "string"
    }
  },
  "required": [
    "driver_profile_id",
    "make",
    "model",
    "size_category",
    "license_plate",
    "exterior_photo_url",
    "interior_photo_url"
  ],
  "rls": {
    "create": {
      "data.driver_profile_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.driver_profile_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.driver_profile_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.driver_profile_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
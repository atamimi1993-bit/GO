{
  "name": "RouteLog",
  "type": "object",
  "properties": {
    "move_request_id": {
      "type": "string"
    },
    "driver_profile_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "actual_mileage": {
      "type": "number",
      "default": 0
    },
    "distance_unit": {
      "type": "string",
      "enum": [
        "mi",
        "km"
      ],
      "default": "mi"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "move_request_id",
    "driver_profile_id",
    "start_time",
    "end_time",
    "actual_mileage"
  ]
}
{
  "name": "MoveRequest",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string",
      "format": "email"
    },
    "customer_phone": {
      "type": "string"
    },
    "pickup_address": {
      "type": "string"
    },
    "pickup_state": {
      "type": "string"
    },
    "dropoff_address": {
      "type": "string"
    },
    "intermediate_stops": {
      "type": "string"
    },
    "move_date": {
      "type": "string",
      "format": "date"
    },
    "move_time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "quoted",
        "accepted",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "residential",
        "freight",
        "corporate_logistics",
        "courier"
      ],
      "default": "residential"
    },
    "delivery_category": {
      "type": "string",
      "enum": [
        "hospital",
        "bank",
        "office",
        "pharmacy",
        "lab_medical",
        "legal_documents",
        "retail",
        "restaurant",
        "other"
      ],
      "default": "other"
    },
    "items_summary": {
      "type": "string"
    },
    "total_weight_lbs": {
      "type": "number",
      "default": 0
    },
    "distance_miles": {
      "type": "number",
      "default": 0
    },
    "distance_unit": {
      "type": "string",
      "enum": [
        "mi",
        "km"
      ],
      "default": "mi"
    },
    "country_code": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "truck_size_needed": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large",
        "extra_large"
      ]
    },
    "service_level": {
      "type": "string",
      "enum": [
        "self_service",
        "standard",
        "full_service"
      ],
      "default": "standard"
    },
    "media_urls": {
      "type": "string"
    },
    "access_media_urls": {
      "type": "string"
    },
    "base_cost": {
      "type": "number",
      "default": 0
    },
    "fuel_cost": {
      "type": "number",
      "default": 0
    },
    "tolls": {
      "type": "number",
      "default": 0
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number",
      "default": 0
    },
    "app_fee": {
      "type": "number",
      "default": 0
    },
    "driver_fee": {
      "type": "number",
      "default": 0
    },
    "total_price": {
      "type": "number",
      "default": 0
    },
    "driver_payout": {
      "type": "number",
      "default": 0
    },
    "bulky_item_fee": {
      "type": "number",
      "default": 0
    },
    "materials_fee": {
      "type": "number",
      "default": 0
    },
    "carrying_fee": {
      "type": "number",
      "default": 0
    },
    "pickup_steps": {
      "type": "number",
      "default": 0
    },
    "dropoff_steps": {
      "type": "number",
      "default": 0
    },
    "pickup_distance_from_street": {
      "type": "number",
      "default": 0
    },
    "dropoff_distance_from_street": {
      "type": "number",
      "default": 0
    },
    "extra_helper": {
      "type": "boolean",
      "default": false
    },
    "elevator_service": {
      "type": "boolean",
      "default": false
    },
    "extra_service_fee": {
      "type": "number",
      "default": 0
    },
    "assigned_driver_id": {
      "type": "string"
    },
    "assigned_driver_name": {
      "type": "string"
    },
    "dispatched_at": {
      "type": "string",
      "format": "date-time"
    },
    "declined_driver_ids": {
      "type": "string",
      "default": ""
    },
    "liability_signed": {
      "type": "boolean",
      "default": false
    },
    "liability_signed_date": {
      "type": "string",
      "format": "date-time"
    },
    "needs_storage": {
      "type": "boolean",
      "default": false
    },
    "storage_days": {
      "type": "number",
      "default": 0
    },
    "items_pdf_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "paid": {
      "type": "boolean",
      "default": false
    },
    "promo_code": {
      "type": "string"
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "discounted_total": {
      "type": "number",
      "default": 0
    },
    "driver_rate_confirmed": {
      "type": "boolean",
      "default": false
    },
    "customer_price_confirmed": {
      "type": "boolean",
      "default": false
    },
    "payment_plan": {
      "type": "boolean",
      "default": false
    },
    "payment_option": {
      "type": "string",
      "enum": [
        "full",
        "split_50_50",
        "installment_plan"
      ],
      "default": "split_50_50"
    },
    "credit_tier": {
      "type": "string",
      "enum": [
        "excellent",
        "good",
        "fair"
      ]
    },
    "installment_term_months": {
      "type": "number",
      "default": 0
    },
    "interest_rate": {
      "type": "number",
      "default": 0
    },
    "installment_total": {
      "type": "number",
      "default": 0
    },
    "monthly_payment": {
      "type": "number",
      "default": 0
    },
    "installments_total_count": {
      "type": "number",
      "default": 0
    },
    "deposit_amount": {
      "type": "number",
      "default": 0
    },
    "balance_due": {
      "type": "number",
      "default": 0
    },
    "deposit_paid": {
      "type": "boolean",
      "default": false
    },
    "installment_amount": {
      "type": "number",
      "default": 0
    },
    "installments_paid": {
      "type": "number",
      "default": 0
    },
    "referral_code": {
      "type": "string"
    },
    "cancellation_fee": {
      "type": "number",
      "default": 250
    },
    "cancellation_fee_paid": {
      "type": "boolean",
      "default": false
    },
    "cancellation_session_id": {
      "type": "string"
    },
    "onsite_photo_url": {
      "type": "string"
    },
    "onsite_verified": {
      "type": "boolean",
      "default": false
    },
    "tip_amount": {
      "type": "number",
      "default": 0
    },
    "tip_paid": {
      "type": "boolean",
      "default": false
    },
    "tip_session_id": {
      "type": "string"
    }
  },
  "required": [
    "pickup_address",
    "dropoff_address",
    "move_date"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
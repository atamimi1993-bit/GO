{
  "name": "PromoCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "discount_percent": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "max_uses": {
      "type": "number",
      "default": 0
    },
    "uses_count": {
      "type": "number",
      "default": 0
    },
    "expires_at": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    },
    "first_time_customers_only": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "code",
    "discount_percent"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
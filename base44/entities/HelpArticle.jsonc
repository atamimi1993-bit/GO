{
  "name": "HelpArticle",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "customer",
        "driver",
        "general",
        "assistants"
      ]
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "content",
    "category"
  ]
}
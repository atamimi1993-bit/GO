{
  "name": "MoveItem",
  "type": "object",
  "properties": {
    "move_request_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "furniture",
        "electronics",
        "appliances",
        "boxes",
        "fragile",
        "heavy_equipment",
        "clothing",
        "other"
      ]
    },
    "weight_lbs": {
      "type": "number",
      "default": 0
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "special_handling": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "move_request_id",
    "name",
    "weight_lbs"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
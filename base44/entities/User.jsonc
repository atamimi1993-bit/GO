{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "promo_channel": {
      "type": "string",
      "enum": [
        "email",
        "text",
        "both",
        "none"
      ],
      "default": "none"
    },
    "phone_number": {
      "type": "string"
    },
    "phone_carrier": {
      "type": "string",
      "enum": [
        "att",
        "verizon",
        "tmobile",
        "sprint",
        "boost",
        "cricket",
        "metropcs",
        "uscellular",
        "googlefi"
      ]
    }
  },
  "required": [
    "role"
  ]
}
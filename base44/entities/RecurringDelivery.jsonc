{
  "name": "RecurringDelivery",
  "type": "object",
  "properties": {
    "business_account_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string",
      "format": "email"
    },
    "customer_phone": {
      "type": "string"
    },
    "pickup_address": {
      "type": "string"
    },
    "dropoff_address": {
      "type": "string"
    },
    "multi_stop_addresses": {
      "type": "string"
    },
    "delivery_category": {
      "type": "string",
      "enum": [
        "hospital",
        "bank",
        "office",
        "pharmacy",
        "lab_medical",
        "legal_documents",
        "retail",
        "restaurant",
        "other"
      ],
      "default": "other"
    },
    "item_description": {
      "type": "string"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "biweekly",
        "monthly"
      ],
      "default": "weekly"
    },
    "day_of_week": {
      "type": "number",
      "default": 1
    },
    "time_slot": {
      "type": "string",
      "default": "Morning (9-12)"
    },
    "requires_signature": {
      "type": "boolean",
      "default": false
    },
    "temperature_controlled": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "last_triggered": {
      "type": "string",
      "format": "date-time"
    },
    "next_trigger": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "customer_email",
    "pickup_address",
    "dropoff_address",
    "frequency",
    "delivery_category"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
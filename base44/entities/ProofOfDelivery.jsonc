{
  "name": "ProofOfDelivery",
  "type": "object",
  "properties": {
    "move_request_id": {
      "type": "string"
    },
    "driver_profile_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "signature_url": {
      "type": "string"
    },
    "recipient_name": {
      "type": "string"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "temperature_verified": {
      "type": "boolean",
      "default": false
    },
    "customer_email": {
      "type": "string",
      "format": "email"
    }
  },
  "required": [
    "move_request_id",
    "driver_profile_id",
    "delivered_at"
  ],
  "rls": {
    "create": {
      "data.driver_profile_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.driver_profile_id": "{{user.id}}"
        },
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.driver_profile_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "Message",
  "type": "object",
  "properties": {
    "move_request_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "customer",
        "driver",
        "admin"
      ],
      "default": "customer"
    },
    "content": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "move_request_id",
    "sender_id",
    "sender_role",
    "content"
  ]
}
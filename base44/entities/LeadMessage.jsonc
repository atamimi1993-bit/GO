{
  "name": "LeadMessage",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string"
    },
    "lead_name": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "initial_outreach",
        "follow_up",
        "referral",
        "qualifier"
      ],
      "default": "initial_outreach"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "phone_script",
        "social_dm",
        "general"
      ],
      "default": "email"
    },
    "content": {
      "type": "string"
    },
    "subject_line": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "responded",
        "no_response"
      ],
      "default": "draft"
    }
  },
  "required": [
    "lead_id",
    "lead_name",
    "message_type",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
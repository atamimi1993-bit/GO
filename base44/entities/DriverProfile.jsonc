{
  "name": "DriverProfile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "license_number": {
      "type": "string"
    },
    "license_expiry": {
      "type": "string",
      "format": "date"
    },
    "license_doc_url": {
      "type": "string"
    },
    "insurance_doc_url": {
      "type": "string"
    },
    "profile_photo_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "suspended",
        "rejected"
      ],
      "default": "pending_review"
    },
    "service_area": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 5.0
    },
    "total_jobs": {
      "type": "number",
      "default": 0
    },
    "total_earnings": {
      "type": "number",
      "default": 0
    },
    "available": {
      "type": "boolean",
      "default": true
    },
    "company_name": {
      "type": "string"
    },
    "cdl_certified": {
      "type": "boolean",
      "default": false
    },
    "cdl_class": {
      "type": "string",
      "enum": [
        "Class A",
        "Class B",
        "None"
      ],
      "default": "None"
    },
    "bank_name": {
      "type": "string"
    },
    "bank_account_type": {
      "type": "string",
      "enum": [
        "checking",
        "savings"
      ],
      "default": "checking"
    },
    "bank_routing_number": {
      "type": "string"
    },
    "bank_account_last4": {
      "type": "string"
    },
    "stripe_account_id": {
      "type": "string"
    },
    "stripe_payouts_enabled": {
      "type": "boolean",
      "default": false
    },
    "referral_code": {
      "type": "string"
    },
    "referred_by_code": {
      "type": "string"
    },
    "sign_on_bonus_eligible": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "full_name",
    "email",
    "phone",
    "license_number"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}